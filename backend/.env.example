ELEVENLABS_API_KEY=sk_...
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1
ELEVENLABS_MODEL=eleven_multilingual_v2
# your ElevenLabs plan's concurrent-request limit (free/starter = 2)
ELEVENLABS_CONCURRENCY=2
# optional: force a default voice id instead of auto-picking
# ELEVENLABS_DEFAULT_VOICE=

# optional: store generated media in S3 and serve it through CloudFront
# S3_BUCKET=yuvin-svg-app-media
# MEDIA_BASE_URL=https://dlg0di6aij6g8.cloudfront.net
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...        (or use an EC2 instance role instead)
# AWS_SECRET_ACCESS_KEY=...
